{
  "expo": {
    "name": "Qualitzer Field",
    "slug": "qualitzer-field",
    "scheme": "qualitzer-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/field-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qualitzer.field",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.qualitzer.field",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4F2",
        "foregroundImage": "./assets/field-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "technical-work", "color": "#226957" }],
      ["expo-image-picker", { "photosPermission": "Qualitzer necesita acceder a las fotos que selecciones como evidencia de tu trabajo.", "cameraPermission": "Qualitzer necesita la cámara para registrar evidencias del trabajo.", "microphonePermission": false }]
    ],
    "web": {
      "favicon": "./assets/field-favicon.png"
    }
  }
}
