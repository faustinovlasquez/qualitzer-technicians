# AGREGAR al entorno del BACKEND EN EL SERVIDOR. No reemplazar su configuración existente.
# Si USE_ENV no es development, cargar estas claves como strings en AWS Secrets Manager.
# No cambiar USE_ENV para habilitar el módulo.

MOBILE_GATEWAY_ENABLED=true
MOBILE_GATEWAY_BACKEND_URL=https://api-demos-qz-v2.qualitzer.com/api

# Crear primero el directorio privado fuera del código, con el usuario Linux de la API y permisos 700.
MOBILE_GATEWAY_SESSION_FILE=/var/lib/qualitzer-mobile/sessions.enc

# OBLIGATORIO: reemplazar por la IP exacta del proxy que conecta a Node; varias IP separadas por comas.
# 127.0.0.1 sólo si esa conexión local se ha confirmado. No usar * ni la IP del teléfono.
MOBILE_GATEWAY_TRUSTED_PROXIES=REEMPLAZAR_POR_IP_REAL_DEL_PROXY

# Dejar vacío para APK nativa. En AWS Secrets Manager debe existir con el valor string vacío "".
MOBILE_GATEWAY_CORS_ORIGINS=