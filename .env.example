BACKEND_URL=https://api.example.com/api
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
GATEWAY_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Google Maps y Places nativos: configurar esta variable en el .env de la app.
# Usar una clave cliente autorizada para el paquete y certificado Android.
# Cambiar la clave requiere recompilar la APK. No guardar la clave real en Git.
GOOGLE_MAPS_API_KEY=

# Las empresas se resuelven en el backend. No configurar TENANT_ORIGIN ni GATEWAY_TENANTS_FILE.
# CORS corresponde al origen del cliente móvil/web, no identifica una empresa.

# Opcional: UUID público real del proyecto Expo/EAS; omitir si no se configura push.
# app.config.ts lo publica como extra.eas.projectId; debe coincidir con el backend.
# No descomentar vacío ni usar un UUID ficticio. Requiere compilación nativa.
# EXPO_PROJECT_ID=

# Opcional: ruta a un archivo local de configuración Firebase para el build Android.
# No sustituye las credenciales privadas FCM/APNs configuradas por separado en EAS.
# No colocar cuentas de servicio, claves ni tokens en este archivo ni en el cliente.
# GOOGLE_SERVICES_FILE=